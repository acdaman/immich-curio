# Immich
IMMICH_URL=http://immich_server:2283
IMMICH_PUBLIC_URL=https://photos.yourdomain.com  # external URL used for links in Telegram captions
IMMICH_API_KEY=
IMMICH_USER_ID=   # your Immich user UUID — Settings > Account > User ID

# Print album — create a "Print" album in Immich, then get its ID via GET /api/albums
PRINT_ALBUM_ID=

# Database (read-only user — see README for setup SQL)
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=immich
DB_USER=immich_reader
DB_PASSWORD=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=   # from @BotFather
TELEGRAM_CHAT_ID=     # your personal chat ID (message @userinfobot to find it)

# Tuning
QUEUE_TARGET_SIZE=40
QUEUE_BATCH_TRIGGER=20

# Export to Syncthing/NFS (optional)
# Set EXPORT_ENABLED=true and mount a volume to /exports in docker-compose.yml
EXPORT_ENABLED=false
EXPORT_DIR=/exports

# Timezone (used by Docker container)
TZ=UTC

# Development
DRY_RUN=false
LOG_LEVEL=INFO
