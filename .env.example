# Immich
IMMICH_URL=http://immich_server:2283
IMMICH_PUBLIC_URL=https://photos.yourdomain.com  # external URL used for links in Telegram captions
IMMICH_API_KEY=
IMMICH_USER_ID=

# Database (read-only user — immich_reader)
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=immich
DB_USER=immich_reader
DB_PASSWORD=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tuning
QUEUE_TARGET_SIZE=10
QUEUE_CHECK_INTERVAL_SECONDS=60
GEMINI_BATCH_SIZE=5

# Export (Syncthing)
EXPORT_DIR=/exports  # Docker: mount /data/syncthing/curio-prints:/exports; local: /data/syncthing/curio-prints

# Development
DRY_RUN=false
LOG_LEVEL=INFO
